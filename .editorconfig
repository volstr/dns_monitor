# Правила оформления файлов для редактора. PyCharm читает этот файл сам, без плагинов.
#
# Зачем он рядом с `.gitattributes`, если тот уже задал концы строк: они отвечают за разное и
# одно другое не заменяет. `.gitattributes` — договор с **Git**, он действует при записи в
# репозиторий и при выгрузке. `.editorconfig` — договор с **редактором**, он действует в момент
# сохранения файла. Без него PyCharm применяет свои настройки: подставляет концы строк по
# системе, дописывает перевод строки в конце и срезает пробелы в концах строк. Файл после этого
# отличается от того, что лежит в репозитории, — и показывается изменённым, хотя человек в нём
# ничего не менял.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.py]
indent_size = 4
# Совпадает с `line-length` в `pyproject.toml`: длину строки задаёт ruff, здесь она продублирована
# только затем, чтобы редактор рисовал границу в том же месте, где потом ругается проверка.
max_line_length = 100

[*.{html,css,js,yml,yaml,toml,json}]
indent_size = 2

[*.md]
indent_size = 2
# Два пробела в конце строки — это перенос строки в Markdown. Срезать их значит менять разметку.
trim_trailing_whitespace = false

# ── Чужие файлы: их нельзя приводить к своим правилам ──────────────────────────
#
# Здесь лежит то, что взято извне и должно побайтово совпадать с источником. Поправленный
# пробел не сломает ни шрифт, ни библиотеку, но сверить файл с оригиналом станет нельзя — а
# именно ради такой сверки чужой код и держат в репозитории целиком (Q-C20, static/README.md).

[guide/**]
# ТЗ и прототип — источники истины, только чтение (`CLAUDE.md`). Правка «на пробел» здесь
# означает расхождение с тем, что прислал заказчик, и разбирать потом придётся его.
trim_trailing_whitespace = false
insert_final_newline = false

[static/js/htmx.min.js]
trim_trailing_whitespace = false
insert_final_newline = false

[static/fonts/OFL-*.txt]
# Текст лицензии распространяется дословно — это её собственное условие.
trim_trailing_whitespace = false
insert_final_newline = false
