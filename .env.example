# Переменные установки — ТЗ 11.10. Запуск окружения разработчика:
#
#   cp .env.example .env
#   docker compose -f docker-compose-dev.yml up
#   docker compose -f docker-compose-dev.yml run --rm web python manage.py migrate
#
# Сам .env не коммитится. Значения ниже годятся только для разработки: в боевой установке
# SESSION_SECRET и пароль базы обязаны быть случайными.
#
# Приложение падает при старте, если обязательная переменная не задана или не проходит проверку
# формата (11.10). Пустые SMTP_HOST, SENTRY_DSN и TELEGRAM_BOT_TOKEN — нормальный режим работы,
# а не ошибка конфигурации.

# ── Режим настроек. Сверх таблицы 11.10, Q-A3 ──────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.dev

# ── UID и GID пользователя приложения. Q-A4 ───────────────────────────────────
# Должны совпадать с вашими на хосте (`id -u`, `id -g`), иначе файлы, созданные внутри
# контейнера — например миграции, — не будут правиться с хоста без sudo.
APP_UID=1000
APP_GID=1000

# Текущий часовой пояс
APP_TIME_ZONE=Europe/Moscow

# ── Обязательные ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://dns_monitoring:dns_monitoring@postgres:5432/dns_monitoring
REDIS_URL=redis://redis:6379
APP_BASE_URL=http://localhost:8000
# Не короче 50 символов. Подставляется в SECRET_KEY Django и в подпись сессии: со сменой
# значения все выданные сессии становятся недействительными.
SESSION_SECRET=zamenite-menya-na-sluchajnoe-znachenie-ne-koroche-50-simvolov

# ── Имена, под которыми приложение отвечает ───────────────────────────────────
# Через запятую: ALLOWED_HOSTS=dns.example.com, 10.20.0.7
# Допустимы имя, адрес, маска поддоменов вида .example.com и звёздочка.
#
# В боевом режиме обязательна. Без неё Django при DEBUG=False отвергает любой запрос, и
# приложение выглядит сломанным, не называя причины, — поэтому оно просто не стартует.
#
# В режиме разработчика можно оставить пустой: localhost, 127.0.0.1 и [::1] добавляются сами.
# Заданные значения при этом сохраняются — пригодится, если открываете по имени машины в сети.
#
# Из APP_BASE_URL не выводится, и это намеренно. APP_BASE_URL — адрес, по которому установку
# открывает человек и который уходит в ссылки уведомлений (8.4); отвечать приложение может ещё
# и по внутреннему имени или за обратным прокси. Две разные величины.
ALLOWED_HOSTS=

# ── Учётная запись Postgres для сервиса postgres в компоузе ───────────────────
# Должна совпадать с тем, что записано в DATABASE_URL выше: эти значения создают базу,
# а та строка к ней подключается.
POSTGRES_DB=dns_monitoring
POSTGRES_USER=dns_monitoring
POSTGRES_PASSWORD=dns_monitoring

# ── Логические базы Redis. 11.11 — состояние и кэш ────────────────────────────
# Общего пространства ключей у них нет, номера обязаны различаться: кэш сбрасывают
# целиком в любой момент, рабочее состояние — никогда.
REDIS_DB_STATE=0
REDIS_DB_CACHE=1

# ── Вход ──────────────────────────────────────────────────────────────────────
# Свойство установки, а не продукта: из интерфейса второй фактор не отключается (ТЗ 3).
AUTH_2FA_ENABLED=false

# ── Резолв ────────────────────────────────────────────────────────────────────
DNS_TIMEOUT_MS=3000
RESOLVE_CONCURRENCY=20

# ── Канал доставки Telegram. Сверх таблицы 11.10, Q-A2 ────────────────────────
# Токен даёт доступ к чужой инфраструктуре, поэтому это свойство установки, а не адресат:
# задаётся здесь, из интерфейса не меняется. Пустое значение — канал «Не настроен».
# Идентификатор чата остаётся в интерфейсе.
TELEGRAM_BOT_TOKEN=

# ── Почта. 8.3: подключение — только здесь ────────────────────────────────────
# Пустой SMTP_HOST выключает отправку писем (критерий 75).
# Если SMTP_HOST задан, остальные переменные проверяются на непротиворечивость при старте:
# SMTP_FROM обязателен, а SMTP_USER и SMTP_PASSWORD задаются только вместе (критерий 77).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=starttls

# ── Sentry. 11.14 ─────────────────────────────────────────────────────────────
# Пустой DSN выключает отправку целиком (критерий 67). Заданный в неверном формате —
# ошибка конфигурации, приложение не стартует (критерий 68).
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0
# Уходит в Sentry релизом: без неё не понять, какое развёртывание сломало работу.
# Пустое значение — релиз не указывается, это рабочий режим. В боевой установке сюда
# кладут тег или короткий хеш коммита, подставляя его при сборке образа.
APP_RELEASE=
