{
  "cleanupPeriodDays": 30,
  "includeCoAuthoredBy": true,
  "permissions": {
    "allow": [
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit -m:*)",
      "Bash(npm run lint)",
      "Bash(npm run test *)",
      "Bash(npm install)",
      "Bash(npm ci)"
    ],
    "deny": [
      "Read(./**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/id_rsa*)",
      "Bash(rm -rf /*)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(sudo:*)"
    ],
    "ask": [
      "Bash(git push --force:*)",
      "Bash(git push:*)",
      "Bash(npm publish:*)",
      "Bash(docker run:*)",
      "Bash(rm:*)",
      "Edit(**/package.json)",
      "Edit(**/*.config.*)"
    ]
  },
  "theme": "dark",
  "model": "opus"
}